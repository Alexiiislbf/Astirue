const DATA = [{"pole": 1, "code": "A01", "street": "AVENUE D’AFRIQUE", "x": 563, "y": 910}, {"pole": 1, "code": "A02", "street": "AVENUE DE ST PIERRE", "x": 808, "y": 590}, {"pole": 1, "code": "A03", "street": "AVENUE DE LA REUNION", "x": 1255, "y": 215}, {"pole": 1, "code": "A04", "street": "AVENUE SEBASTOPOL", "x": 1404, "y": 343}, {"pole": 1, "code": "A05", "street": "AVENUE D’ALLEMAGNE", "x": 1231, "y": 746}, {"pole": 1, "code": "A06", "street": "AVENUE D’ESPAGNE", "x": 1339, "y": 709}, {"pole": 1, "code": "A07", "street": "AVENUE DE FRANCE", "x": 1280, "y": 848}, {"pole": 1, "code": "A08", "street": "AVENUE DU ROYAUME UNI", "x": 1502, "y": 685}, {"pole": 1, "code": "B01", "street": "BOULEVARD DE LA REPUBLIQUE", "x": 878, "y": 409}, {"pole": 1, "code": "B02", "street": "BOULEVARD DES LEGIONS", "x": 1104, "y": 683}, {"pole": 1, "code": "B03", "street": "IMPASSE CSTAGN", "x": 494, "y": 584}, {"pole": 1, "code": "B04", "street": "IMPASSE DE ST PIERRE", "x": 637, "y": 526}, {"pole": 1, "code": "B05", "street": "IMPASSE DE LA MARECHAUSSEE", "x": 999, "y": 258}, {"pole": 1, "code": "B06", "street": "IMPASSE DE LA REPUBLIQUE", "x": 1140, "y": 205}, {"pole": 1, "code": "B07", "street": "IMPASSE DE LA REUNION", "x": 1382, "y": 109}, {"pole": 1, "code": "B08", "street": "IMPASSE D’ESPAGNE", "x": 1288, "y": 921}, {"pole": 1, "code": "B09", "street": "IMPASSE DES PAYS-BAS", "x": 1542, "y": 887}, {"pole": 1, "code": "B10", "street": "PLACE DE LA LOI", "x": 1029, "y": 508}, {"pole": 1, "code": "B11", "street": "PLACE DE L’EUROPE", "x": 1150, "y": 410}, {"pole": 1, "code": "B12", "street": "PLACE DES JUSTES", "x": 1331, "y": 554}, {"pole": 1, "code": "B13", "street": "PLACE STE JEANNE D’ARC", "x": 1425, "y": 255}, {"pole": 1, "code": "B14", "street": "PLACE DE BUCAREST", "x": 1443, "y": 692}, {"pole": 1, "code": "B15", "street": "PLACE DES CONNETABLES", "x": 1762, "y": 732}, {"pole": 1, "code": "B16", "street": "PLACE DU MAJOR LECOMTE", "x": 964, "y": 750}, {"pole": 1, "code": "B17", "street": "SQUARE PIERRE 1ER", "x": 1077, "y": 264}, {"pole": 1, "code": "B18", "street": "SQUARE ALEXANDRE 1ER", "x": 1375, "y": 174}, {"pole": 1, "code": "B19", "street": "COTE DU RESEAU ST JACQUES", "x": 1497, "y": 590}, {"pole": 1, "code": "B20", "street": "PISTE ROUGE", "x": 1239, "y": 618}, {"pole": 1, "code": "C01", "street": "RUE DES ANTILLES", "x": 914, "y": 556}, {"pole": 1, "code": "C02", "street": "RUE DU GENIE", "x": 876, "y": 577}, {"pole": 1, "code": "C03", "street": "RUE GENERAL RADET", "x": 1005, "y": 632}, {"pole": 1, "code": "C04", "street": "RUE LT JULES SAVE", "x": 1073, "y": 441}, {"pole": 1, "code": "C05", "street": "RUE DES PREVOTS", "x": 1120, "y": 499}, {"pole": 1, "code": "C06", "street": "RUE CNE LANGLOIS", "x": 1171, "y": 551}, {"pole": 1, "code": "C07", "street": "RUE MONGE", "x": 1144, "y": 611}, {"pole": 1, "code": "C08", "street": "RUE CATINAT", "x": 1177, "y": 767}, {"pole": 1, "code": "C09", "street": "RUE DE LA MARECHAUSSEE", "x": 1133, "y": 313}, {"pole": 1, "code": "C10", "street": "RUE VILLODRIGO", "x": 1318, "y": 286}, {"pole": 1, "code": "C11", "street": "RUE D’EXTREME ORIENT", "x": 1277, "y": 267}, {"pole": 1, "code": "C12", "street": "RUE DE TURQUIE", "x": 1440, "y": 368}, {"pole": 1, "code": "C13", "street": "RUE DE LA NOUVELLE CALEDONIE", "x": 1368, "y": 399}, {"pole": 1, "code": "C14", "street": "RUE D’ARGENTINE", "x": 1473, "y": 465}, {"pole": 1, "code": "C15", "street": "RUE DU MAROC", "x": 1401, "y": 501}, {"pole": 1, "code": "C16", "street": "RUE DU PORTUGAL", "x": 1442, "y": 759}, {"pole": 1, "code": "C17", "street": "RUE DES PAYS-BAS", "x": 1548, "y": 778}, {"pole": 1, "code": "D01", "street": "TOUR DE DIRECTION", "x": 1167, "y": 514}, {"pole": 1, "code": "D02", "street": "VILLA MONGE", "x": 1155, "y": 637}, {"pole": 2, "code": "A01", "street": "AVENUE DEU LIEUTENANT FONTAN", "x": 677, "y": 1016}, {"pole": 2, "code": "A02", "street": "RUE DU CAPITAINE GUUILLAUDOT", "x": 929, "y": 702}, {"pole": 2, "code": "A03", "street": "RUE DES GEN JOFFRE ET CHOLEN", "x": 897, "y": 819}, {"pole": 2, "code": "A04", "street": "PLACE DES SERGENTS D’ARMES", "x": 929, "y": 983}, {"pole": 2, "code": "A05", "street": "RUE DU MARECHAL MONCEY", "x": 1441, "y": 780}, {"pole": 2, "code": "A06", "street": "RUE DU GEN ZANADZU", "x": 1276, "y": 748}, {"pole": 2, "code": "A07", "street": "RUE DU MAJOR MOULIE", "x": 1385, "y": 704}, {"pole": 2, "code": "A08", "street": "RUE MDC LUCKZAC", "x": 1376, "y": 615}, {"pole": 2, "code": "A09", "street": "RUE GEN DUJARDIN", "x": 1538, "y": 655}, {"pole": 2, "code": "A10", "street": "RUE GARDE JONCELLE", "x": 1643, "y": 620}, {"pole": 2, "code": "A11", "street": "ROUTE DE CROGNAC", "x": 1298, "y": 558}, {"pole": 2, "code": "A12", "street": "PISTE BLEUE", "x": 934, "y": 781}, {"pole": 3, "code": "A01", "street": "COTE DU RESEAU ST-JACQUES", "x": 249, "y": 1008}, {"pole": 3, "code": "A02", "street": "PLACE DES VERTUS MILITAIRES", "x": 787, "y": 974}, {"pole": 3, "code": "A03", "street": "RUE DU CAPITAINE JEAN D’HERS", "x": 1131, "y": 796}, {"pole": 3, "code": "A04", "street": "PLACE DU MAJOR DESCAMPS", "x": 1690, "y": 583}, {"pole": 3, "code": "A05", "street": "PISTE JAUNE", "x": 1056, "y": 866}];
const IMAGES = {"1": "data:image/jpeg;base64,", "2": "data:image/jpeg;base64,", "3": "data:image/jpeg;base64,"};
const root = {
  pole: document.getElementById('pole'),
  count: document.getElementById('count'),
  start: document.getElementById('start'),
  canvas: document.getElementById('map'),
  polePill: document.getElementById('polePill'),
  code: document.getElementById('code'),
  answer: document.getElementById('answer'),
  street: document.getElementById('street'),
  reveal: document.getElementById('reveal'),
  next: document.getElementById('next'),
  knew: document.getElementById('knew'),
  review: document.getElementById('review'),
  toggleView: document.getElementById('toggleView'),
  score: document.getElementById('score'),
  progress: document.getElementById('progressBar'),
  reviewBox: document.getElementById('reviewBox'),
  reviewList: document.getElementById('reviewList'),
  status: document.getElementById('status'),
  successFill: document.getElementById('successFill'),
  successPct: document.getElementById('successPct'),
  finalMessage: document.getElementById('finalMessage'),
  finalScore: document.getElementById('finalScore'),
  encouragement: document.getElementById('encouragement'),
  finalDetail: document.getElementById('finalDetail')
};
const ctx = root.canvas.getContext('2d');
let imgs = {}, session = [], index = 0, current = null, revealed = false, fullView = false;
let known = 0, toReview = [], sessionSize = 0;

function shuffle(a){
  const x=[...a];
  for(let i=x.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [x[i],x[j]]=[x[j],x[i]]; }
  return x;
}

async function loadImages(){
  const tasks = [1,2,3].map(p => new Promise((resolve,reject)=>{
    const img = new Image();
    imgs[p] = img;

    // IMPORTANT MOBILE : installer les gestionnaires AVANT d'affecter src.
    img.onload = () => resolve();
    img.onerror = () => reject(new Error('Carte du pôle '+p+' non chargée.'));
    img.src = IMAGES[p];

    // Sécurité pour certains navigateurs qui considèrent déjà le data-URI comme chargé.
    if (img.complete && img.naturalWidth > 0) resolve();
  }));

  // Chargement parallèle, plus rapide sur téléphone.
  await Promise.all(tasks);
}

function filteredPool(){
  const p = root.pole.value;
  return DATA.filter(q => p === 'all' || String(q.pole) === p);
}

function startSession(){
  let pool = shuffle(filteredPool());
  let wanted = root.count.value === 'all' ? pool.length : Number(root.count.value);
  wanted = Math.max(1, Math.min(wanted, pool.length));
  session = pool.slice(0, wanted);
  sessionSize = session.length;
  index = 0; known = 0; toReview = []; revealed = false; fullView = false;
  root.reviewBox.classList.remove('visible');
  root.reviewList.innerHTML='';
  root.successFill.style.width='0%'; root.successPct.textContent='0%'; root.progress.style.width='0%';
  root.finalMessage.classList.remove('visible');
  root.finalScore.textContent=''; root.encouragement.textContent=''; root.finalDetail.textContent='';
  showQuestion();
}

function showQuestion(){
  if(index >= session.length){
    finishSession(); return;
  }
  current = session[index];
  revealed = false;
  root.answer.classList.remove('visible');
  root.street.textContent = '';
  root.reveal.disabled = false;
  root.next.disabled = true;
  root.knew.disabled = true;
  root.review.disabled = true;
  root.polePill.textContent = 'PÔLE ' + current.pole;
  root.code.textContent = current.code;
  root.status.textContent = 'Retrouvez le nom réel de cette voie, puis cliquez sur « Réponse ».';
  fullView = false;
  root.toggleView.textContent = 'Voir la carte entière';
  updateScore();
  drawMap();
}

function drawMap(){
  if(!current || !imgs[current.pole]) return;
  const img = imgs[current.pole];
  const outW = 1100, outH = 650;
  root.canvas.width = outW; root.canvas.height = outH;
  ctx.clearRect(0,0,outW,outH);

  let sx=0, sy=0, sw=img.width, sh=img.height;
  if(!fullView){
    sw = 760; sh = 450;
    sx = current.x - sw/2; sy = current.y - sh/2;
    sx = Math.max(0, Math.min(sx, img.width-sw));
    sy = Math.max(0, Math.min(sy, img.height-sh));
  }
  ctx.drawImage(img, sx, sy, sw, sh, 0, 0, outW, outH);

  const tx = (current.x - sx) / sw * outW;
  const ty = (current.y - sy) / sh * outH;
  const baseR = fullView ? 31 : 48;

  ctx.save();
  ctx.beginPath(); ctx.arc(tx,ty,baseR,0,Math.PI*2);
  ctx.fillStyle='rgba(255,230,0,.24)'; ctx.fill();
  ctx.lineWidth=7; ctx.strokeStyle='#d40000'; ctx.stroke();
  ctx.beginPath(); ctx.arc(tx,ty,baseR+10,0,Math.PI*2);
  ctx.lineWidth=2.5; ctx.strokeStyle='rgba(212,0,0,.75)'; ctx.stroke();
  ctx.restore();
}

function reveal(){
  if(!current) return;
  revealed = true;
  root.street.textContent = current.street;
  root.answer.classList.add('visible');
  root.reveal.disabled = true;
  root.knew.disabled = false;
  root.review.disabled = false;
  root.status.textContent = 'Auto-évaluez-vous : « Je savais » ou « À revoir ».';
}

function mark(knewIt){
  if(!revealed) return;
  if(knewIt) known++;
  else toReview.push(current);
  root.knew.disabled = true;
  root.review.disabled = true;
  root.next.disabled = false;
  root.status.textContent = knewIt ? 'Validé.' : 'Ajouté à la liste « À revoir ».';
  updateScore();
}

function next(){
  index++;
  showQuestion();
}

function updateScore(){
  const evaluated = known + toReview.length;
  const qPct = sessionSize ? Math.round((evaluated / sessionSize) * 100) : 0;
  const goodPct = sessionSize ? Math.round((known / sessionSize) * 100) : 0;

  const shownQuestion = sessionSize ? Math.min(index + 1, sessionSize) : 0;
  root.score.textContent = `Question ${shownQuestion} / ${sessionSize} · Bonnes : ${known} · À revoir : ${toReview.length}`;

  // Barre générale : avance dès qu'une réponse est évaluée.
  root.progress.style.width = `${qPct}%`;

  // Barre "Bonnes réponses" : avance UNIQUEMENT avec "Je savais".
  root.successPct.textContent = `${goodPct}%`;
  root.successFill.style.width = `${goodPct}%`;
}

function finishSession(){
  current = null;
  const pct = sessionSize ? Math.round((known / sessionSize) * 100) : 0;

  let msg = '';
  if (pct === 100) {
    msg = 'Excellent ! Parcours parfait : toutes les voies sont maîtrisées.';
  } else if (pct >= 90) {
    msg = 'Très solide ! Tu es prêt : encore un dernier passage pour verrouiller les quelques hésitations.';
  } else if (pct >= 80) {
    msg = 'Très bon niveau ! La carte est bien acquise. Concentre-toi maintenant sur les quelques voies à revoir.';
  } else if (pct >= 70) {
    msg = 'Bon niveau ! Les bases sont là. Quelques séries ciblées te feront rapidement gagner les derniers points.';
  } else if (pct >= 60) {
    msg = 'Ça progresse bien ! Reprends les voies à revoir puis relance une série courte.';
  } else {
    msg = 'Continue l’entraînement : des séries courtes et répétées vont rapidement faire monter ton score.';
  }

  root.code.textContent = 'Terminé';
  root.polePill.textContent = 'SESSION';
  root.answer.classList.remove('visible');
  root.reveal.disabled = true;
  root.next.disabled = true;
  root.knew.disabled = true;
  root.review.disabled = true;

  root.status.textContent = `Résultat final : ${known} bonne(s) réponse(s) sur ${sessionSize}.`;
  root.score.textContent = `Score : ${known} / ${sessionSize} · ${pct}% · À revoir : ${toReview.length}`;
  root.progress.style.width = '100%';
  root.successPct.textContent = `${pct}%`;
  root.successFill.style.width = `${pct}%`;

  root.finalScore.textContent = `${known} / ${sessionSize} — ${pct}%`;
  root.encouragement.textContent = msg;
  root.finalDetail.textContent = toReview.length
    ? `${toReview.length} voie(s) sont enregistrée(s) dans la liste « À revoir ».`
    : 'Aucune voie à revoir dans cette série.';
  root.finalMessage.classList.add('visible');

  ctx.clearRect(0,0,root.canvas.width,root.canvas.height);
  ctx.fillStyle = '#f8fafc';
  ctx.fillRect(0,0,root.canvas.width,root.canvas.height);
  ctx.textAlign = 'center';
  ctx.fillStyle = '#17365d';
  ctx.font = 'bold 42px Arial';
  ctx.fillText('Session terminée', root.canvas.width/2, 235);
  ctx.fillStyle = '#166534';
  ctx.font = 'bold 42px Arial';
  ctx.fillText(`${pct}%`, root.canvas.width/2, 300);
  ctx.fillStyle = '#475569';
  ctx.font = '25px Arial';
  ctx.fillText(`${known} / ${sessionSize} bonnes réponses`, root.canvas.width/2, 350);

  root.reviewBox.classList.toggle('visible', toReview.length > 0);
  root.reviewList.innerHTML = toReview.map(q =>
    `<span class="review-item">Pôle ${q.pole} · ${q.code} · ${escapeHtml(q.street)}</span>`
  ).join('');
}

function escapeHtml(s){
  return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'})[c]);
}

root.start.addEventListener('click', startSession);
root.reveal.addEventListener('click', reveal);
root.knew.addEventListener('click', ()=>mark(true));
root.review.addEventListener('click', ()=>mark(false));
root.next.addEventListener('click', next);
root.toggleView.addEventListener('click', ()=>{
  if(!current) return;
  fullView=!fullView;
  root.toggleView.textContent=fullView?'Revenir au zoom':'Voir la carte entière';
  drawMap();
});
window.addEventListener('resize', ()=>{ if(current) drawMap(); });
document.addEventListener('keydown', e=>{
  if(e.target && ['INPUT','SELECT','TEXTAREA'].includes(e.target.tagName)) return;
  if(e.code==='Space' && current && !revealed){ e.preventDefault(); reveal(); }
  if(e.code==='Enter' && !root.next.disabled){ e.preventDefault(); next(); }
});

let mobileLoadTimeout = setTimeout(()=>{
  root.status.textContent = 'Le chargement prend plus de temps que prévu. Fermez puis rouvrez le fichier si nécessaire.';
}, 12000);

loadImages().then(()=>{
  clearTimeout(mobileLoadTimeout);
  root.start.disabled=false;
  root.status.textContent='Cartes prêtes.';
  startSession();
}).catch((err)=>{
  clearTimeout(mobileLoadTimeout);
  root.start.disabled=false;
  root.status.textContent='Une carte n’a pas pu être chargée. Le fichier a peut-être été ouvert dans un aperçu limité : utilisez Chrome, Safari, Edge ou Firefox.';
  console.error(err);
});
</script>
</body>
</html>
