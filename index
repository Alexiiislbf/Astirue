<style>
:root{
  --bg:#f5f7fa; --card:#fff; --ink:#172033; --muted:#64748b; --line:#dbe3ee;
  --accent:#17365d; --accent2:#245d8f; --good:#16794b; --bad:#b42318; --warn:#b45309;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif}
.wrap{max-width:1180px;margin:0 auto;padding:20px}
header{display:flex;gap:18px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:14px}
h1{font-size:26px;margin:0 0 5px;color:var(--accent)}
.brand{display:flex;flex-direction:column;gap:8px;min-width:320px;max-width:760px}.brand-logo{display:block;max-width:720px;width:100%;height:auto}.sub{color:var(--muted);font-size:14px;max-width:820px;line-height:1.35}
.controls{display:flex;gap:10px;flex-wrap:wrap;align-items:end}
.control label{display:block;color:var(--muted);font-size:12px;margin-bottom:4px;font-weight:700}
select,button{font:inherit}
select{padding:10px 12px;border:1px solid var(--line);border-radius:9px;background:white;min-height:42px}
button{border:0;border-radius:10px;padding:11px 16px;min-height:44px;font-weight:700;cursor:pointer}
button:disabled{opacity:.45;cursor:not-allowed}
.btn-main{background:var(--accent);color:white}
.btn-alt{background:#e9eef5;color:var(--accent)}
.btn-answer{background:#f59e0b;color:#111827}
.btn-good{background:#dcfce7;color:#14532d}
.btn-bad{background:#fee2e2;color:#7f1d1d}
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}
.toprow{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;margin-bottom:10px}
.question-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.pill{background:#e8eef6;color:var(--accent);padding:6px 9px;border-radius:999px;font-weight:700;font-size:13px}
.code{font-size:27px;font-weight:800;letter-spacing:.7px;color:var(--accent)}
.score{text-align:right;font-size:13px;color:var(--muted)}
.mapbox{background:#eef2f6;border:1px solid var(--line);border-radius:12px;overflow:hidden;position:relative}
canvas{display:block;width:100%;height:auto;background:#fff}
.map-actions{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-top:10px}
.left-actions,.right-actions{display:flex;gap:8px;flex-wrap:wrap}
.answer{margin-top:12px;border-left:5px solid #f59e0b;background:#fff7e6;border-radius:8px;padding:13px 15px;display:none}
.answer.visible{display:block}
.answer .street{font-size:24px;font-weight:800;color:#7c3d00;margin-top:4px}
.hint{margin-top:9px;color:var(--muted);font-size:12.5px}
.progress{height:8px;background:#e6edf5;border-radius:999px;overflow:hidden;margin-top:8px}
.progress>div{height:100%;background:var(--accent2);width:0}
.review-box{margin-top:14px;display:none}
.review-box.visible{display:block}
.review-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.review-item{border:1px solid #f2c7c2;background:#fff6f5;color:#8a2018;padding:5px 8px;border-radius:7px;font-size:12px}
.notice{margin-top:12px;padding:10px 12px;border-radius:9px;background:#eaf2fb;color:#244768;font-size:13px;line-height:1.35}
kbd{border:1px solid #cbd5e1;border-bottom-width:2px;background:white;border-radius:5px;padding:1px 5px;font-size:11px}
@media (max-width:700px){
  .wrap{padding:10px}
  h1{font-size:21px}
  .toprow{grid-template-columns:1fr}
  .score{text-align:left}
  .code{font-size:23px}
  .answer .street{font-size:20px}
  button{flex:1}
}

.success-wrap{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:8px}
.success-label{font-size:13px;font-weight:800;color:var(--accent)}
.success-track{flex:1;min-width:180px;height:12px;background:#e5e7eb;border-radius:999px;overflow:hidden;border:1px solid #d1d5db}
.success-fill{height:100%;width:0;background:linear-gradient(90deg,#16a34a,#22c55e);transition:width .25s ease}
.success-pct{min-width:52px;text-align:right;font-weight:900;color:#166534}
.final-message{margin-top:14px;padding:16px 18px;border-radius:12px;background:#eef6ff;border:1px solid #cfe0f5;display:none}
.final-message.visible{display:block}
.final-message .bigscore{font-size:31px;font-weight:900;color:var(--accent);margin-bottom:5px}
.final-message .encourage{font-size:18px;font-weight:800;color:#1f2937}
.final-message .detail{margin-top:6px;color:var(--muted);font-size:13px}

